# Copy to .env for local / docker-compose runs:
#   cp .env.example .env
# Never commit a populated .env file.

# Compose and bare development default to local. Set this to prod for any
# shared deployment; prod fails closed unless authentication is configured.
ENVIRONMENT=local
# Replace with `git rev-parse HEAD` for every production image/deployment.
# Production Redis is rejected while this remains unknown, preventing stale
# results from leaking across code revisions.
GIT_SHA=unknown
# Inject an immutable deployed image identity: the Docker config image ID for
# a host-local build, or the OCI manifest digest on a registry-backed platform.
# Generic local runs may keep this placeholder; claimable benchmarks reject it.
IMAGE_DIGEST=unknown

# Optional bearer token for crawl/extraction endpoints. Health diagnostics and
# OpenAPI discovery remain public. Leave blank ONLY on a trusted private
# network — an empty token leaves the data endpoints unauthenticated.
CRAWL4AI_API_TOKEN=
# Independent high-entropy HMAC key (at least 32 characters). Required in prod;
# do not reuse CRAWL4AI_API_TOKEN. Empty selects a process-local random key
# outside production.
SERVING_FINGERPRINT_KEY=

# CORS: comma-separated allow-list of browser origins. Empty (default) disables
# cross-origin browser access entirely. Set e.g. https://app.example.com to
# allow one origin. "*" is accepted but strongly discouraged.
CORS_ALLOW_ORIGINS=

# Concurrency
MAX_CONCURRENT_TASKS=5
MAX_CONCURRENT_PAGES=2
MAX_DOMAINS_PER_REQUEST=50
DEFAULT_MAX_PAGES=1
MAX_PENDING_REQUESTS=100
MAX_REQUEST_BODY_BYTES=1048576
CRAWL_REQUEST_TIMEOUT_S=120
MAX_RESPONSE_OUTPUT_BYTES=33554432
MAP_TIMEOUT_S=30
MAP_MAX_DOWNLOAD_BYTES=20971520
MAP_MAX_CONCURRENCY=4

# JS rendering: conditional | force | never
JS_RENDER_MODE=conditional

# Rate limiting
RATE_LIMIT_REQUESTS_PER_SECOND=2.0
RATE_LIMIT_BURST=5
RATE_LIMIT_MAX_DOMAINS=1000

# HTTP client
HTTP_TIMEOUT_S=30
HTTP_CONNECT_TIMEOUT_S=5
HTTP_TOTAL_TIMEOUT_S=45
HTTP_MAX_KEEPALIVE_CONNECTIONS=50
HTTP_MAX_CONNECTIONS=100
HTTP_USER_AGENT=ClusyCrawler/1.0
HTTP_MAX_ATTEMPTS=3
HTTP_RETRY_MAX_DELAY_S=5
HTTP_PROXY=
PLAYWRIGHT_PROXY=

# Recursive crawl robots policy (max_depth > 0 only). There is no request-side
# bypass. 2xx is parsed; ordinary 4xx means unavailable/allow; 408/425/429,
# 5xx, timeout, unsafe redirect, oversized, or ambiguous policy fails closed.
ROBOTS_TIMEOUT_S=5
ROBOTS_MAX_REDIRECTS=5
ROBOTS_MAX_BODY_BYTES=524288
ROBOTS_MAX_URL_LENGTH=4096
ROBOTS_MAX_RULES=4096
ROBOTS_MAX_RECORDS=8192
ROBOTS_MAX_LINE_CHARS=8192
ROBOTS_MAX_CONCURRENCY=16
ROBOTS_CACHE_MAX_ENTRIES=2048
ROBOTS_CACHE_TTL_S=3600
ROBOTS_UNAVAILABLE_CACHE_TTL_S=900
ROBOTS_ERROR_CACHE_TTL_S=60

# Content extraction
PARALLEL_EXTRACTION_ENABLED=true
EXTRACTION_MERGE_MODE=union
NATIVE_EXTRACTION_ENABLED=true
NATIVE_EXTRACTION_MIN_CONFIDENCE=0.60
MAX_CONCURRENT_EXTRACTIONS=2
EXTRACT_MAX_TEXT_LENGTH=500000

# Playwright
# Browser-capable source and image profiles default both switches to true.
# Leave them unset here so this shared env file does not override the
# static-runtime image's baked false values. Set them explicitly only for a
# browser-capable deployment that needs a non-default policy.
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_JAVA_SCRIPT_ENABLED=true
PLAYWRIGHT_TIMEOUT_S=30
PLAYWRIGHT_DISABLE_SANDBOX=false
PLAYWRIGHT_MAX_HTML_BYTES=10485760

# Optional high-quality model-assisted extraction. The "quality" profile
# computes its deterministic candidate first, then attempts this backend on
# every eligible request. "adaptive" attempts it only after a bounded,
# label-free risk decision. Both preserve their deterministic candidate when
# this OpenAI-compatible endpoint is unavailable.
QUALITY_EXTRACTION_BASE_URL=
QUALITY_EXTRACTION_API_KEY=
QUALITY_EXTRACTION_MODEL=
# Immutable model/backend build identity. Successful model output is not
# persisted in Redis while this is empty.
QUALITY_EXTRACTION_BACKEND_REVISION=
# openai_json = v2/JSON for general instruction models.
# mineru_compact = short_compact/compact wire contract for compatible local
# checkpoints. The official v1.1 Hunyuan-derived weights have territorial and
# use restrictions; they are not bundled and require a separate legal review.
QUALITY_EXTRACTION_PROMPT_PROFILE=openai_json
QUALITY_EXTRACTION_TIMEOUT_S=45
QUALITY_EXTRACTION_CAPACITY_TIMEOUT_S=1
QUALITY_EXTRACTION_SHUTDOWN_TIMEOUT_S=5
QUALITY_EXTRACTION_MAX_INPUT_CHARS=1000000
# Hard-capped at 2 because the pinned serializer is process-global.
QUALITY_EXTRACTION_MAX_CONCURRENCY=2
QUALITY_EXTRACTION_FAILURE_THRESHOLD=3
QUALITY_EXTRACTION_COOLDOWN_S=30
ADAPTIVE_EXTRACTION_MIN_CONFIDENCE=0.75
ADAPTIVE_EXTRACTION_STRUCTURAL_SCORE_THRESHOLD=3
ADAPTIVE_EXTRACTION_STRUCTURE_LOSS_THRESHOLD=1
ADAPTIVE_EXTRACTION_CANDIDATE_DISAGREEMENT_THRESHOLD=0.45
ADAPTIVE_EXTRACTION_MAX_SCAN_CHARS=200000
ADAPTIVE_EXTRACTION_RISKY_PAGE_TYPES=collection,listing,product

# Metadata-only scholarly fallbacks. Crossref DOI lookup needs no key.
# Elsevier and IEEE calls are disabled unless their official API key is set.
SCHOLARLY_METADATA_ENABLED=true
SCHOLARLY_METADATA_TIMEOUT_S=8
SCHOLARLY_METADATA_MAX_CONCURRENCY=2
SCHOLARLY_METADATA_MAX_RESPONSE_BYTES=524288
ACADEMIC_PDF_FALLBACK_TIMEOUT_S=12
ELSEVIER_API_KEY=
IEEE_API_KEY=

# Optional schema/prompt extraction concurrency and deadline.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5
EXTRACTION_MAX_TOKENS=8192
EXTRACTION_MAX_INPUT_CHARS=100000
STRUCTURED_EXTRACTION_MAX_CONCURRENCY=2
STRUCTURED_EXTRACTION_TIMEOUT_S=45

# Redis cache (optional)
REDIS_URL=
CACHE_TTL_S=3600
CACHE_CONNECT_TIMEOUT_S=0.75
CACHE_OPERATION_TIMEOUT_S=0.5
CACHE_FAILURE_COOLDOWN_S=5
CACHE_MAX_ENTRY_BYTES=1048576
