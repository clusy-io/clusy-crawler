{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "raw_archive_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_manifest_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_retention": {
          "enum": [
            "repository",
            "external_retained",
            "not_retained"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256",
        "raw_manifest_sha256",
        "raw_archive_sha256",
        "raw_retention"
      ],
      "type": "object"
    },
    "claim": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "benchmark_result",
            "implementation_benchmark",
            "vendor_benchmark",
            "deployment",
            "rejection"
          ]
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/metric"
          },
          "minItems": 1,
          "type": "array"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "recorded_at_utc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "enum": [
            "Verified",
            "Diagnostic",
            "Historical",
            "Rejected"
          ]
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "required": [
        "id",
        "status",
        "kind",
        "recorded_at_utc",
        "source",
        "protocol",
        "artifact",
        "scope",
        "metrics",
        "permissions",
        "verification"
      ],
      "type": "object"
    },
    "decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "documentation": {
      "additionalProperties": false,
      "properties": {
        "enforced_files": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/safePath"
              },
              {
                "pattern": "\\.md$"
              }
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "marker_format": {
          "const": "<!-- clusy-evidence: <claim-id> -->"
        },
        "migration_status": {
          "enum": [
            "pending",
            "enforced"
          ]
        }
      },
      "required": [
        "migration_status",
        "enforced_files",
        "marker_format"
      ],
      "type": "object"
    },
    "metric": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "minLength": 1,
          "type": "string"
        },
        "artifact_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "type": "string"
        },
        "display": {
          "minLength": 1,
          "type": "string"
        },
        "format": {
          "pattern": "^\\+?\\.[0-9]{1,2}f$",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9._-]{1,63}$",
          "type": "string"
        },
        "unit": {
          "enum": [
            "ratio",
            "score",
            "percent",
            "pages_per_second",
            "milliseconds",
            "bytes",
            "count"
          ]
        },
        "value": {
          "$ref": "#/$defs/decimal"
        }
      },
      "required": [
        "key",
        "value",
        "display",
        "format",
        "unit",
        "aggregation",
        "artifact_pointer"
      ],
      "type": "object"
    },
    "permissions": {
      "additionalProperties": false,
      "properties": {
        "current_production": {
          "const": false
        },
        "metric": {
          "type": "boolean"
        },
        "scoped_sota": {
          "$ref": "#/$defs/permissionGate"
        },
        "scoped_superiority": {
          "$ref": "#/$defs/permissionGate"
        },
        "vendor_superiority": {
          "$ref": "#/$defs/permissionGate"
        }
      },
      "required": [
        "metric",
        "scoped_superiority",
        "vendor_superiority",
        "scoped_sota",
        "current_production"
      ],
      "type": "object"
    },
    "permissionGate": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "artifact_pointer": {
          "anyOf": [
            {
              "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "allowed",
        "artifact_pointer"
      ],
      "type": "object"
    },
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "safePath": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000)[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "schemaBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "bench/evidence/registry.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "comparators": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "version": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "dataset": {
          "minLength": 1,
          "type": "string"
        },
        "dataset_revision": {
          "minLength": 1,
          "type": "string"
        },
        "dataset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_boundary": {
          "minLength": 1,
          "type": "string"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "output_contract": {
          "minLength": 1,
          "type": "string"
        },
        "pages": {
          "minimum": 1,
          "type": "integer"
        },
        "profile": {
          "minLength": 1,
          "type": "string"
        },
        "split": {
          "minLength": 1,
          "type": "string"
        },
        "task": {
          "minLength": 1,
          "type": "string"
        },
        "vendors": {
          "items": {
            "enum": [
              "Clusy",
              "Exa",
              "Firecrawl"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "task",
        "dataset",
        "dataset_revision",
        "dataset_sha256",
        "split",
        "profile",
        "pages",
        "output_contract",
        "execution_boundary",
        "comparators",
        "vendors",
        "limitations"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "clean": {
          "type": "boolean"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "runtime_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "clean",
        "runtime_source_sha256"
      ],
      "type": "object"
    },
    "utcTimestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "artifact_complete_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "type": "string"
        },
        "binding_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "type": "string"
        },
        "claimable_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "type": "string"
        },
        "source_stable_pointer": {
          "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$",
          "type": "string"
        }
      },
      "required": [
        "binding_pointer",
        "claimable_pointer",
        "source_stable_pointer",
        "artifact_complete_pointer"
      ],
      "type": "object"
    }
  },
  "$id": "https://clusy.io/schemas/benchmark-evidence-registry-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/claim"
      },
      "type": "array"
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "registry_id": {
      "const": "clusy.benchmark-evidence-registry.v1"
    },
    "registry_note": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "$ref": "#/$defs/schemaBinding"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "schema",
    "registry_note",
    "documentation",
    "claims"
  ],
  "title": "Clusy benchmark evidence registry",
  "type": "object"
}
